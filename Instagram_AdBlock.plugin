#!name = Instagram 信息流去广告
#!desc = 轻量过滤 Instagram App 首页信息流中的 Sponsored 广告，仅解密首页时间线接口。
#!author = Codex
#!date = 2026-08-26
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)
#!tag = 去广告,Instagram,社交

[Script]
# Instagram App 首页信息流
http-response ^https:\/\/(?:i|b)\.instagram\.com\/api\/v1\/feed\/timeline\/?(?:\?|$) script-path=https://raw.githubusercontent.com/shengrui123/loon-rules/main/Instagram_AdBlock.js,tag=Instagram App 信息流去广告,requires-body=true,binary-body-mode=false,timeout=10,enable=true

[MITM]
hostname = i.instagram.com, b.i.instagram.com
